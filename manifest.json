{
  "manifest_version": 3,
  "name": "Stafford Academy",
  "version": "1.0.0",
  "description": "Learn Python, AI, electronics and robotics one mission at a time: 22 free courses that run in your browser, no installs and no account.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Stafford Academy"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ]
}
